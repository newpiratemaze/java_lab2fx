<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="CENTER" prefHeight="691.0" prefWidth="867.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab2fx.GameController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Pane fx:id="gamePane" prefHeight="600.0" prefWidth="828.0">
         <children>
            <Circle fx:id="ball" fill="RED" layoutX="414.0" layoutY="300.0" onMouseClicked="#handleMouseClick" radius="30.0" stroke="BLACK" strokeType="INSIDE" />
         </children>
      </Pane>
      <Label fx:id="scoreLabel" text="Label" />
   </children>

</VBox>
